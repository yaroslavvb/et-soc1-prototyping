+/* Choose what the performance counters count: syscall(SYSCALL_PMC_CONFIGURE, target, value, 0).
+   target = kind << 56 | fields (see PMC_CFG_* below). Returns 0, or -1 for a bad target. */
+#define SYSCALL_PMC_CONFIGURE (SYSCALL_UMODE_THRESHOLD + 12)
+
+#define PMC_CFG_KIND_CORE 0ULL /* fields: mhpmevent CSR 0x324-0x328 of the calling hart; value: event id */
+#define PMC_CFG_KIND_SC   1ULL /* fields: shire << 16 | bank << 8 | reg (0 P0 qual, 1 P1 qual, 2 ctl_status) */
+#define PMC_CFG_KIND_MS   2ULL /* fields: memshire << 8 | reg (0 P0 qual, 1 P1 qual, 2 P0 qual2, 3 P1 qual2, 4 ctl_status) */
