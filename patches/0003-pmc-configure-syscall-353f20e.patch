     uint64_t scp_enabled, uint64_t cacheop_reprate, uint64_t cacheop_max);
 static int64_t set_l1_cache_control(uint64_t d1_split, uint64_t scp_en);
 
+/* Lets a kernel choose what the performance counters count (SYSCALL_PMC_CONFIGURE).
+   mhpmevent3 is refused: hpmcounter3 must keep counting cycles, the firmware's time stamp. */
+static int64_t configure_pmc(uint64_t target, uint64_t value)
+{
+    const uint64_t kind = target >> 56;
+    const uint64_t reg = target & 0xFF;
+
+    if (kind == PMC_CFG_KIND_CORE)
+    {
+        const uint64_t evt_reg = target & 0xFFF;
+        if (evt_reg < PMU_MHPMEVENT4 || evt_reg > PMU_MHPMEVENT8)
+        {
+            return -1;
+        }
+        /* counter CSR = event CSR + 0x7E0 (0x324 -> 0xB04) */
+        (void)pmu_core_counter_write(evt_reg + (PMU_MHPMCOUNTER3 - PMU_MHPMEVENT3), 0);
+        return pmu_core_event_configure(evt_reg, value);
+    }
+    if (kind == PMC_CFG_KIND_SC)
+    {
+        const uint64_t shire = (target >> 16) & 0xFF;
+        const uint64_t bank = (target >> 8) & 0xFF;
+        if (shire > 32 || bank > 3 || reg > 2)
+        {
+            return -1;
+        }
+        if (reg == 2)
+        {
+            pmu_shire_cache_counter_set(shire, bank, value);
+            return 0;
+        }
+        return pmu_shire_cache_event_configure(shire, bank, reg, value);
+    }
+    if (kind == PMC_CFG_KIND_MS)
+    {
+        const uint64_t ms = (target >> 8) & 0xFF;
+        if (ms > 7 || reg > 4)
+        {
+            return -1;
+        }
+        if (reg == 4)
+        {
+            pmu_memshire_event_set(ms, value);
+            return 0;
+        }
+        return pmu_memshire_event_configure(ms, reg, value);
+    }
+    return -1;
+}
+
 int64_t syscall_handler(uint64_t number, uint64_t arg1, uint64_t arg2, uint64_t arg3)
 {
     int64_t ret = SYSCALL_INTERNAL_SUCCESS;
@@ -133,6 +183,9 @@
         case SYSCALL_PMC_MS_SAMPLE_INT:
             ret = (int64_t)sample_ms_pmcs(arg1, arg2);
             break;
+        case SYSCALL_PMC_CONFIGURE_INT:
+            ret = configure_pmc(arg1, arg2);
+            break;
         case SYSCALL_PMC_SC_SAMPLE_ALL_INT:
             ret = sample_sc_pmcs_all(arg1, arg2, (shire_pmc_cnt_t *)arg3);
             break;
