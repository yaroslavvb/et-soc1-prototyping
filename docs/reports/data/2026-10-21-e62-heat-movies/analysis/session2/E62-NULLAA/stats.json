{
 "block": "E62-NULLAA",
 "block_label": "E62-NULLAA",
 "block_label_how": "the protocol's own name",
 "kind": "control",
 "title": "The instrumental null: the same mask in both arms",
 "predicted": {
  "what": "Zero, with no appeal to geometry at all -- the two arms are the SAME mask at the same per-shire, so the drive never changes and the prediction is zero by construction rather than by a blur model. It runs at E62-WE42's own dwell, power and set, and it now runs SIXTH, before E62-NULLGEO, E62-W8BE8B and E62-SWEEP, so the measured floor exists before the blocks whose published error bars and whose detectability depend on it (version 1 ran it tenth of ten). Four analysed laps on the quadratically balanced 8-phase order give a 2 sigma bound of 27 mK, 5.8% of E62-WE42's prediction. It is reduced TWICE: over all four analysed laps (the clean sigma every error bar uses), and over its first two analysed laps on the 4-phase order -- the exact configuration of every two-lap block in the session -- so the residual quadratic drift leak those blocks carry is bounded by a matched null rather than argued away.",
  "mk": 0.0,
  "direction": "none",
  "basis": "E61's null was a permutation -- a relabelling of real data. This is a physical null: a real repeat with nothing swapped. It is the only control whose zero does not depend on the die map being right, so if E62-NULLGEO ever comes out non-null this block separates 'the instrument' from 'the die map'.",
  "anchor": {
   "travel_mm": 0.0,
   "switched_w": 15.6,
   "dwell_s": 42.5,
   "formula": "372.9 mK x (travel_mm / 10.012) x (switched_w / 14.40) x (transfer(dwell_s) / transfer(41.7 s))"
  },
  "bound_2sigma_mk": 27.0
 },
 "pass_rule": "PASS if the half-patch statistic is 0 +/- 27.0 mK (2 sigma over the four analysed laps at the registered 27 mK floor). Analysed through exactly E62-WE42's pipeline, including its sign order and its detrend, so the two are directly comparable; and again over its first two analysed laps alone, for the matched two-lap bound. Any non-zero result is the instrument or the analysis, and it is subtracted from nothing: it is reported as the honest floor under every other number, and the measured value REPLACES the 27 mK prior in every error bar and every SNR on the page.",
 "detrend": {
  "order": 1,
  "levels": null,
  "trends": 1,
