   "stays_gone": 1.1,
   "follow": 0.03
  },
  "R5_gap_int8_bycol": {
   "text": "int8, gemmc1, zeros / full, sustained rate (zeros / sparse50 if the limit refused full, labelled). COMES BACK >= 1.15; STAYS GONE < 1.05; else PARTIAL. E101's as-run gap is x1.00.",
   "comes_back": 1.15,
   "stays_gone": 1.05
  },
  "R6_vendor_between": {
   "text": "fp32, gemmv1, zeros / sparse25, sustained rate, strictly between gemm1's and gemmc1's in this session, each ratio's own run (or E101's as-run value if gemm1 sparse25 was cut). PASS: as-run + 0.01 < ratio < by-column - 0.01. Else FAIL: the strides do not sit where their miss share puts them."
  },
  "R7_T800_per_layout": {
   "text": "fp32 zeros, T at 800 MHz (wall / ops per minion, launches at or above 790 MHz) within 12% of the frozen T_800 of each of gemm1, gemmv1, gemmc1; and the order gemmc1 < gemmv1 < gemm1. PASS or FAIL per layout.",
   "band": 0.12
  },
  "R8_cold": {
   "text": "fp32, one pass over 16 blocks, gemmc16 and gemmv16 (each block touched once per pass, 48 MB against a 32 MB L3): T at 800 MHz within 25% of the frozen T_800, zeros / randn sustained or burst rate <= 1.06: in a cold block the clock does not set the pace in either layout.",
   "band": 0.25,
   "gap_max": 1.06
  },
  "R9_halfk": {
