   "lo_mhz": [
    590,
    610
   ],
   "hi_mhz": 790,
   "min_lo": 2,
   "min_hi": 5,
   "primary": "fp32"
  },
  "R0_ties": {
   "text": "the ties, which label every other verdict on a FAIL: (a) every check of C exact or approx; (b) each new arm's T at 600 MHz (clock_x's T600, else the fit's C/600 + M) within 1.5% of E107's T at 600 MHz on aifoundry3 (E119 found this card 0.2-0.5% under it); (c) each replicate arm's fp32 zeros T at >= 790 MHz within 1% of E119's.",
