#!/bin/sh
# Named stub-* so that its process name never matches a device tool's (lib.sh DEV_COMM; the DV2 gate scans for those).
# NV dry-run stand-in for et-who --check: exit NV_STUB_ETWHO_RC (default 0, nobody holds a card)
[ "${NV_STUB_ETWHO_RC:-0}" = 0 ] || echo "/dev/et0_ops someone 1234 stub"
exit "${NV_STUB_ETWHO_RC:-0}"
