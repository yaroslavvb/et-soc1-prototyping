  "when": "after E183's data commit, in a later records round, from the committed data directory's scored-e183.json; labelled blind and reported",
  "words": [
   "the version's centre lies inside, above or below the measured 95% interval (inside: lo <= centre <= hi)",
   "the measured estimate lies inside, above or below the version's own band, as listed (inside: band low <= estimate <= band high)",
   "the sign: the estimate's or the other (no sign to compare when either is 0)"
  ]
 },
