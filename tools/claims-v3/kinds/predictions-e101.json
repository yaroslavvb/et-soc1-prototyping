 "rules": {
  "min_passes": 3,
  "kinds_for_rank": [
   "zeros",
   "ones",
   "random",
   "sparse50",
   "real"
  ],
  "R1_tie_e37": {
   "what": "mm16 on E37's fill reads E37's board watts over idle (leakage difference taken off) within the band, and every mm16 cell runs E37's cycles per op within the share",
   "band_w": 1.5,
   "cpo_rel": 0.005,
   "means": {
    "PASS": "the ported loop is E37's benchmark, so its numbers tie to E37's 24-26 W",
    "FAIL": "the port differs from E37's benchmark: every mm16 number carries that difference, and the README says which way"
   }
  },
  "R2_tie_e78": {
   "what": "the resident cells read E78's S within the band, on the new binary",
   "band_w": 0.6,
   "cells": [
    "fp32.zeros",
    "fp32.randn",
    "fp16.zeros",
    "fp16.randn",
    "int8.zeros",
    "int8.full",
    "fp32.ones",
    "fp16.ones",
    "int8.ones",
    "fp32.sparse50",
    "fp16.sparse50",
    "int8.sparse50"
   ],
   "means": {
    "PASS": "the session sits in E78's frame and the arms can be read against the kinds page",
    "FAIL": "the session drifted from E78: read the arms against this session's resident cells only"
   }
  },
  "R3_premium": {
   "what": "S(mm16) - r S(res), paired per pass, in each of zeros, ones, random, sparse50 and each format: the 95% lower bound is above the bar: a real matmul pays the memory path whatever the data",
   "bar_w": 1.0,
   "means": {
    "PASS": "every per-kind watt on the page is low for a matmul that streams",
    "FAIL": "in that cell streaming costs nothing the loop did not: the page's number stands for it"
   }
  },
  "R3b_model": {
   "what": "rms of measured S minus the frozen S over the 12 cells of R3 (mm16), over the 12 of gemm1",
   "mm16_rms_w": 3.0,
   "gemm1_rms_w": 4.0,
   "means": {
    "PASS": "resident power plus E37's path cost plus E75's prices predicts a streamed cell",
    "FAIL": "the three published numbers do not add up to a streamed cell, and the residuals say which term is off"
   }
  },
  "R4_clause": {
   "what": "E39's kernel clause on one fill: S(mm16.int8.e37) - S(res.int8.e37), paired: PASS if the 95% interval overlaps the frozen range and the mean is inside it; FAIL if the interval lies outside; else INCONCLUSIVE. fp32 and fp16 are reported",
   "means": {
    "PASS": "the +18 W of the claims register is the kernel, not the different fill",
    "FAIL": "part of the +18 W was the fill"
   }
  },
  "R5_memory_data": {
   "what": "M = [S(arm, random) - S(arm, zeros)] - r [S(res, random) - S(res, zeros)], paired, mm16 in each format, against E75's prices times the tile's changed bits. Three-way as R4. gemm1 is reported",
   "means": {
    "PASS": "the memory path's data-dependent power is the size E75's prices say",
    "FAIL": "E75's prices, measured on bare loads, do not carry over to a matmul's loads"
   }
  },
  "R5b_memory_constant": {
   "what": "[S(mm16, ones) - S(mm16, zeros)] - r [S(res, ones) - S(res, zeros)], paired: PASS if the 95% interval lies inside the band, FAIL if wholly outside, else INCONCLUSIVE",
   "band_w": 1.0,
   "means": {
    "PASS": "a constant costs the memory path what zeros do",
    "FAIL": "the path pays for the constant itself, not only for changes"
   }
  },
  "R6_rank": {
   "what": "Spearman rho between S(res) and S(arm) over the five kinds within each format, for mm16 and gemm1",
   "rho": 0.9,
   "rho_four_kinds": 0.8,
   "means": {
    "PASS": "the kinds rank as on the page",
    "FAIL": "streaming reorders the kinds, and the table on the page is the loop's"
   }
  },
  "R7_gate": {
   "what": "zeros' share S(arm, zeros) / S(arm, random) per format. R7a: the 95% lower bound is above the resident share E78 measured. R7b: the upper bound is below the bar",
   "bar": 0.75,
   "means": {
    "R7a": "zeros' 5-7% of random is the loop's figure",
    "R7b": "the gate still saves a quarter or more in a real matmul",
    "FAIL_R7b": "in that format zeros hardly save power once the operands stream"
   }
  },
  "R8_coop": {
   "what": "S(mm16, random) - S(gemm1, random) and S(gemmnc1, random) - S(gemm1, random), paired, per format: PASS if the 95% lower bound is above 0, FAIL if the upper bound is below 0, else INCONCLUSIVE",
   "means": {
    "PASS": "the production pattern draws less than the benchmark: E37's watts overstate a cooperative GEMM",
    "FAIL": "cooperative loads do not save board power"
   }
  },
  "R9_correct": {
   "what": "no check record reads wrong; every zeros run reads exact; every int8 run reads exact",
   "means": {
    "PASS": "the kernels compute what they should on every kind",
    "FAIL": "a kernel takes a different path on some data: that is a finding, reported with the cells"
   }
  },
  "R9b_cycles": {
   "what": "within each arm and format the cycles per op of every kind agree within the share: the data does not change the count",
   "cpo_rel": 0.01,
   "means": {
    "PASS": "as in the loop, the data never changes the cycle count, streaming or not",
    "FAIL": "the data changes the cycle count in a streamed matmul: the page's first sentence is the loop's"
   }
  },
  "R10_heat": {
   "what": "the OLS slope of the die's rise on S over every cell with S >= 12 W, all arms, lies in the band",
   "band_c_per_w": [
    0.1,
    0.14
   ],
   "min_s_w": 12.0,
   "means": {
    "PASS": "a watt spent on the memory path heats the die sensor as a watt on the lanes does",
    "FAIL": "the memory path's watts reach the sensor differently, and the heat line must carry the arm"
   }
  },
  "R11_dram": {
   "what": "S(mmp64.fp32.randn) - S(mmp64.fp32.zeros), paired, three-way against the frozen range; its cycles per op inside E37's range +- 10%",
   "means": {
    "PASS": "the DRAM path's data dependence, at E37's traffic, is the size E75 and E81 say",
    "FAIL": "it is not"
   }
  },
  "R12_gemm16": {
   "what": "S(gemm16, random) - S(gemm16, zeros), paired, per format: the 95% lower bound is above 0; the cycles per op and its ratio to gemm1's are reported, with no band: nothing predicted them",
   "means": {
    "PASS": "the kinds still set the power of a GEMM past the L3",
    "FAIL": "past the L3 the memory path's stalls hide the kinds"
   }
  },
  "S1_fp32_burst": {
   "what": "aifoundry2: zeros over random fp32, TFLOPS, 1.5-6.5 s of a 6 s burst from a cool die, gemm1 (and mm16 where the cool burst is allowed). GROWS >= 1.20 (the frozen prediction: 1.21, mm16 1.25); SURVIVES in [1.10, 1.20); SHRINKS < 1.10",
   "grows": 1.2,
   "survives": 1.1,
   "means": {
    "GROWS": "the page's x1.13-1.15 understates a matmul that streams",
    "SURVIVES": "the page's x1.13-1.15 stands",
    "SHRINKS": "the page's burst gap belongs to the loop"
   }
  },
  "S2_fp32_sustained": {
   "what": "aifoundry2: the same over the last 40 s of about 76 s. SURVIVES in [1.20, 1.40] (the frozen prediction: 1.33); else FAILS",
   "lo": 1.2,
   "hi": 1.4,
   "means": {
    "SURVIVES": "the page's x1.29-1.33 stands",
    "FAILS": "the sustained gap belongs to the loop: the README says which way it moved"
   }
  },
  "S3_int8": {
   "what": "aifoundry2: zeros over random int8, sustained, gemm1 and mm16. The frozen prediction: 1.19 and 1.22. SLOWS >= 1.05; HARDLY < 1.03; between: INCONCLUSIVE. The burst is reported (1.03 and 1.13 predicted)",
   "slows": 1.05,
   "hardly": 1.03,
   "means": {
    "SLOWS": "'int8 hardly slows' belongs to the loop: a real int8 matmul meets the trip",
    "HARDLY": "int8 hardly slows in a real matmul too"
   }
  },
  "S4_relation": {
   "what": "aifoundry2: rms of measured minus frozen clock (E83's relation on the frozen S) over the cells, burst and sustained",
   "rms_mhz": 40.0,
   "means": {
    "PASS": "the chain kind -> watts -> clock carries over to a matmul that streams",
    "FAIL": "it does not, on the frozen S; the relation on session 1's measured S is scored beside it, labelled"
   }
  },
  "S5_real": {
   "what": "aifoundry2: the real set against random, in each format, gemm1: burst and sustained clocks within the bar",
   "bar_mhz": 25.0,
   "means": {
    "PASS": "real float tensors stream at random data's speed",
    "FAIL": "real tensors and random data part once the operands stream"
   }
  }
 },
