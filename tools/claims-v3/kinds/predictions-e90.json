 "rules": {
  "E90-R1": {
   "what": "random signs at a fixed magnitude cost what their sign-bit flips cost",
   "steps": [
    "fp32.signs-fp32.ones",
    "fp16.signs-fp16.ones",
    "fp32.pm_pi-anchor_pi"
   ],
   "per_step": "paired per pass; PASS if the 95% upper bound <= FACTOR x P_bits, FAIL if the 95% lower bound > FACTOR x P_bits, else INCONCLUSIVE",
   "factor": 2.0,
   "rule": "PASS if all three steps pass; FAIL if any fails; else INCONCLUSIVE"
  },
  "E90-R2": {
   "what": "random signs on random magnitudes cost what their sign-bit flips cost",
   "steps": [
    "fp32.randn-fp32.abs_randn",
    "fp16.randn-fp16.abs_randn"
   ],
   "per_step": "as E90-R1",
   "factor": 2.0,
   "rule": "PASS if both pass; FAIL if either fails"
  },
  "E90-R3": {
   "what": "a static set sign bit costs nothing",
   "steps": [
    "fp32.negabs_randn-fp32.abs_randn",
    "fp16.negabs_randn-fp16.abs_randn"
   ],
   "per_step": "paired per pass; PASS if the 95% interval lies inside +-0.3 W, FAIL if it lies entirely outside, else INCONCLUSIVE",
   "band_w": 0.3,
   "rule": "PASS if both pass; FAIL if either fails"
  },
  "E90-R4": {
   "what": "E78's committed tile represents its rule (the prediction: E78's measured value)",
   "kinds": [
    "fp32.sparse50",
    "fp16.nn_like",
    "fp16.uniform01"
   ],
   "per_kind": "mean over the three fresh draws of D(draw) - D(committed tile), paired per pass; PASS if its 95% interval lies inside +-0.5 W, FAIL if it lies entirely outside, else INCONCLUSIVE",
   "band_w": 0.5,
   "rule": "PASS if all three kinds pass; FAIL if any fails"
  },
  "E90-R5": {
   "what": "Q130(n)'s predictor tracks the draws (its delta against the committed tile)",
   "per_draw": "measured paired D(draw) - D(committed) against q130n_delta_vs_committed_w",
   "rule": "PASS if rms over the nine draws <= 0.50 W and no draw whose predicted |delta| >= 0.30 W is resolved (95%) on the other side of zero; FAIL if rms > 1.00 W or any such draw is; else INCONCLUSIVE"
  },
  "E90-S1": {
   "what": "the session tie (reported, not a model test)",
   "cells": {
    "fp32.randn": 0.5,
    "fp16.randn": 0.5,
    "fp32.ones": 0.5,
    "fp16.ones": 0.5,
    "anchor_pi": 0.5,
    "fp32.sparse50": 0.5,
    "fp16.nn_like": 0.5,
    "fp16.uniform01": 0.5,
    "int8.full": 0.25
   },
   "rule": "each cell's D within its band of E78's; a failure means the session moved"
  },
  "E90-S2": {
   "what": "Q130(n)'s predictor's 95% interval holds every E90 tile",
   "rule": "count of the 17 E90 tiles whose D lies inside q130n_predictor.pi95_w; PASS if >= 14"
  }
 },
