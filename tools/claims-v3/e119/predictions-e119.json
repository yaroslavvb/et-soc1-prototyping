 "rules": {
  "limit_p800_w": 88.0,
  "peak_lock_w": 93.0,
  "R0_tie": {
   "text": "zeros T at 800 MHz (wall / ops per minion, launches at or above 790 MHz on the kernel's own clock) of c1 within 2% of E105's aifoundry2 gemmc1 in fp32 and fp16 and within 3% in int8 (E107's R1 found int8's repeated block 2.3% apart between builds), and of c16 fp32 within 3% of E105's gemmc16; every check of C exact or approx. A FAIL labels every other verdict.",
   "c1_rel": {
    "fp32": 0.02,
    "fp16": 0.02,
    "int8": 0.03
   },
   "c16_rel": 0.03,
   "e105_T800_c1": {
    "fp32": 0.6779,
    "fp16": 0.6779,
    "int8": 0.3775
   },
   "e105_T800_c16_fp32": 2.435
  },
  "R1_reuse_800": {
   "text": "per format, E107's R3 at 800 MHz: fit T800(R) = Tinf + D / R over R in {1, 2, 4, 8, 32} (c16, c16r2, c16r4, c16r8, c16r32), each rung's T800 from its zeros (random's where zeros has none). REUSE IS THE VARIABLE AT 800 MHz: |Tinf - T800(c1)| <= 0.05 T800(c1) and every rung within 3% of the fit. NOT THE VARIABLE: T800(c16r32) - T800(c1) >= 0.5 (T800(c16) - T800(c1)). Else PARTIAL. No verdict with fewer than 4 rungs or without c1 and c16.",
   "tinf_rel": 0.05,
   "point_rel": 0.03,
   "not_frac": 0.5,
   "primary": "fp32",
   "frozen": "REUSE IS THE VARIABLE AT 800 MHz in all three formats"
  },
  "R2_clock_buys": {
   "text": "X = T600 / T800 per arm and format, this session's launches only: T600 the mean T of launches whose kernel clock (cycles_max / wall) is in [590, 610] MHz, T800 of those at or above 790 MHz, every kind pooled (at a given clock the kind does not change the count, R4); at least 2 launches at 600 and 5 at 800, else from the fit T = C/f + M over 590-810 MHz, else no verdict. Per ladder arm (c16r32, c16r8, c16r4, c16r2, c16) and c1: PASS if |X - X(M1)| <= 0.03. ORDER: X(c1) > X(c16r32) > X(c16r8) > X(c16r4) > X(c16r2) > X(c16) in fp32: the clock buys less the less a block is reused.",
   "band": 0.03,
   "lo_mhz": [
    590,
    610
   ],
   "hi_mhz": 790,
   "min_lo": 2,
   "min_hi": 5,
   "primary": "fp32"
  },
  "R3_l3_walk": {
   "text": "c8s, the 8-block walk whose 24 MB of operands sit in the L3: X against M1 (the L3's extra time is a wait outside the minion clock) and M2 (it follows the clock). share = (X - X(M1)) / (X(M2) - X(M1)). OUTSIDE THE CLOCK: share <= 0.25. FOLLOWS THE CLOCK: share >= 0.75. Else PARTIAL, with the share. Per format; fp32 primary.",
   "outside_max": 0.25,
   "follows_min": 0.75,
   "primary": "fp32"
  },
  "R4_kind": {
   "text": "at a given clock the kind does not change the count in the walks either: every arm's random T at or above 790 MHz within 1% of its zeros'. PASS / FAIL, the worst cell named.",
   "rel": 0.01
  },
  "R5_gap_sus": {
   "text": "the governed speed gap, sustained: zeros / random sustained rate per admitted arm with both sustained runs, against the frozen gap (M1 with the clock model). PASS per cell if within 0.05. ORDER (fp32): c16r8 > c16r4 > c16r2 > 1.02 >= c16's burst gap: the gap shrinks along the ladder, where the clock buys less and random draws less.",
   "band": 0.05
  },
  "R6_estimate": {
   "text": "the admission estimate over-reads a walk: every admitted random cell's measured burst board power at 800 MHz (reduce_kspeed's p800_w) at or below its estimate + 1 W. A FAIL means the rule under-read a cell; future runs then add the excess.",
   "slack_w": 1.0
  }
