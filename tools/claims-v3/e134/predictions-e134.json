 "rules": {
  "E134-R1": {
   "what": "A's low bits on W79 (E102-R2's low-bit half, on a second card): the ratio all-in / balanced per flipped bit at bits 0 and 6",
   "bits": [
    0,
    6
   ],
   "threshold": 4.0,
   "verdicts": "POSITION if the upper bound < 4 at both; CONSTANT if the lower bound >= 4 at both; else INCONCLUSIVE; NOT SCORED under 3 kept A blocks",
   "expected": "POSITION (the bench: 1.00 at both; real sums: no result-path change at either; E102 post hoc 0.95 and 0.99 on card 1)"
  },
  "E134-R2": {
   "what": "does a single A bit's price depend on its base word? all-in at bit 6, W67 minus W79, board W, paired by block",
   "contrast": "A_word_allin_6",
   "bench_W": 0.5238,
   "sign": 1,
   "word_threshold_w": 0.2619,
   "same_band_w": 0.1,
   "verdicts": "WORD if the interval's end nearer zero is beyond half the bench's difference, on the bench's side; SAME if the interval lies inside +-0.10 W; else INCONCLUSIVE",
   "expected": "WORD (the bench and E67 against E102 both say W67 is dearer at bit 6; position-only and the real-sum counts say 0)"
  },
  "E134-R3": {
   "what": "where W67's bit-6 cost sits: the ratio all-in / balanced per flipped bit on W67 at bit 6",
   "ratio": "A_W67_allin_over_bal_6",
   "flip_band": [
    0.5,
    2.0
   ],
   "swing_threshold": 2.0,
   "verdicts": "FLIP if the interval lies inside [0.5, 2.0); SWING if the lower bound >= 2.0; else INCONCLUSIVE",
   "expected": "FLIP (the word acts through the multiplier, which both layouts drive alike; the sums do not part at bit 6)"
  },
  "E134-R4": {
   "what": "where B's accumulator swing starts: the swing's watts (all-in minus balanced x 4096/3968) at the frozen counts' quiet and onset bits",
   "quiet_bit": 7,
   "onset_bit": 8,
   "none_band_w": 0.1,
   "verdicts": "AT 8 if the quiet bit's interval lies inside +-0.10 W and the onset bit's lower bound > 0; EARLIER if the quiet bit's lower bound > 0; LATER if both lie inside +-0.10 W; else INCONCLUSIVE",
   "expected": "AT 8 (real sums: 0 result bits an op at bit 7, 4551 at bit 8)"
  },
  "E134-R5": {
   "what": "the bench's word differences over A's low bits (all-in, W67 minus W79): at every bit where the bench puts it at 0.10 W or more",
   "bits": [
    2,
    4,
    5,
    6
   ],
   "verdicts": "AGREES if every bit whose interval excludes zero has the bench's sign and at least half of the bits resolve; DISAGREES if any resolved bit has the other sign; else INCONCLUSIVE",
   "expected": "AGREES"
  },
  "E134-S1": {
   "what": "E67's own tiles (W67 all-in, bits 0-7, byte for byte E67's) against E67's list on this card",
   "band_abs_w": 0.15,
   "band_rel": 0.25,
   "band_se_mult": 2.0,
   "min_inside": 6,
   "verdicts": "PASS if at least 6 of 8 lie within max(0.15 W, 25% of E67's value, 2 x E67's s.e.) of E67's value; else FAIL",
   "expected": "PASS"
  }
 },
